---
/**
 * Banner de consentimento (LGPD + Google Consent Mode v2).
 * Qualquer elemento com `data-consent-open` reabre o banner (ex.: Política de Privacidade).
 */
export interface Props {}
---

<div id="fs-consent" class="consent-banner" role="region" aria-label="Preferências de privacidade" hidden>
  <p class="consent-text">
    <strong>Sua privacidade importa.</strong> Uso cookies do Google Ads apenas para saber quais anúncios
    trazem contatos reais. Sem venda de dados, sem perfil de consumo.{" "}
    <a href="/privacidade#cookies-terceiros">Saiba mais</a>
  </p>
  <div class="consent-actions">
    <button type="button" class="consent-btn consent-btn-ghost" data-consent-choice="denied">
      Recusar
    </button>
    <button type="button" class="consent-btn consent-btn-primary" data-consent-choice="granted">
      Aceitar
    </button>
  </div>
</div>
<script is:inline>
  (function () {
    var KEY = "fs_consent_v1";
    var banner = document.getElementById("fs-consent");
    if (!banner) return;

    var stored = null;
    try {
      stored = localStorage.getItem(KEY);
    } catch (e) {}
    if (stored !== "granted" && stored !== "denied") banner.hidden = false;

    banner.addEventListener("click", function (ev) {
      var btn = ev.target.closest("[data-consent-choice]");
      if (!btn) return;
      var choice = btn.getAttribute("data-consent-choice");
      try {
        localStorage.setItem(KEY, choice);
      } catch (e) {}
      if (typeof window.gtag === "function") {
        window.gtag("consent", "update", {
          ad_storage: choice,
          ad_user_data: choice,
          ad_personalization: choice,
          analytics_storage: choice,
        });
      }
      banner.hidden = true;
    });

    document.addEventListener("click", function (ev) {
      if (ev.target.closest && ev.target.closest("[data-consent-open]")) {
        ev.preventDefault();
        banner.hidden = false;
        var first = banner.querySelector("button");
        if (first) first.focus();
      }
    });
  })();
</script>

<style>
  .consent-banner {
    position: fixed;
    left: 50%;
    bottom: max(16px, env(safe-area-inset-bottom));
    transform: translateX(-50%);
    z-index: 100;
    width: min(760px, calc(100% - 32px));
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 16px 18px;
    background: #121514;
    border: 1px solid var(--line);
    border-left: 2px solid var(--copper);
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.55);
    color: #d9ddd4;
  }
  .consent-banner[hidden] {
    display: none;
  }
  .consent-text {
    margin: 0;
    font-size: 14px;
    line-height: 1.6;
  }
  .consent-text strong {
    color: #f4f4f0;
  }
  .consent-text a {
    color: var(--copper);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .consent-actions {
    display: flex;
    gap: 10px;
    flex-shrink: 0;
  }
  .consent-btn {
    min-height: 44px;
    padding: 10px 18px;
    font-size: 14px;
    font-weight: 600;
    border: 1px solid #424443;
    background: transparent;
    color: #f4f4f0;
  }
  .consent-btn-ghost:hover {
    border-color: var(--copper);
  }
  .consent-btn-primary {
    background: var(--copper);
    border-color: var(--copper);
    color: #0b0d0e;
  }
  .consent-btn-primary:hover {
    filter: brightness(1.08);
  }
  @media (max-width: 640px) {
    .consent-banner {
      flex-direction: column;
      align-items: stretch;
      gap: 14px;
    }
    .consent-actions .consent-btn {
      flex: 1;
    }
  }
</style>
