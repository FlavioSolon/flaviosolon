---
/**
 * Google tag (gtag.js) oficial para Google Ads (AW-18567586959) + Consent Mode v2
 * + conversão "Contato WhatsApp / E-mail" (AW-18567586959/q6GfCMWR6rUdEI_J25VF).
 */
export interface Props {}
---

<!-- Google tag (gtag.js) -->
<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=AW-18567586959"></script>
<script is:inline>
  (function () {
    var ADS_ID = "AW-18567586959";
    var SEND_TO = "AW-18567586959/q6GfCMWR6rUdEI_J25VF";

    window.dataLayer = window.dataLayer || [];
    function gtag() {
      window.dataLayer.push(arguments);
    }
    window.gtag = gtag;

    // Consent Mode v2 — negado por padrão até a escolha do visitante.
    gtag("consent", "default", {
      ad_storage: "denied",
      ad_user_data: "denied",
      ad_personalization: "denied",
      analytics_storage: "denied",
      wait_for_update: 500,
    });
    gtag("set", "ads_data_redaction", true);
    gtag("set", "url_passthrough", true);

    var stored = null;
    try {
      stored = localStorage.getItem("fs_consent_v1");
    } catch (e) {}
    if (stored === "granted") {
      gtag("consent", "update", {
        ad_storage: "granted",
        ad_user_data: "granted",
        ad_personalization: "granted",
        analytics_storage: "granted",
      });
    }

    gtag("js", new Date());
    gtag("config", ADS_ID);

    // Event snippet for Contato WhatsApp / E-mail conversion
    var lastFire = 0;
    document.addEventListener(
      "click",
      function (ev) {
        var link = ev.target && ev.target.closest ? ev.target.closest("a[href]") : null;
        if (!link) return;
        var href = link.getAttribute("href") || "";
        var isContact =
          /^(https?:\/\/(wa\.me|api\.whatsapp\.com|web\.whatsapp\.com)\/|whatsapp:|mailto:|tel:)/i.test(
            href,
          );
        if (!isContact) return;

        var now = Date.now();
        if (now - lastFire < 1500) return;
        lastFire = now;

        gtag("event", "conversion", {
          send_to: SEND_TO,
          value: 1.0,
          currency: "BRL",
        });
      },
      { capture: true, passive: true },
    );
  })();
</script>
