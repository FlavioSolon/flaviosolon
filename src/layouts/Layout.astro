---
import '@/index.css';
import { generateSeo } from '@/lib/seo';

interface Props {
  title?: string;
  description?: string;
  path?: string;
  ogImage?: string;
  ogType?: 'website' | 'article' | 'profile';
}

const { title: customTitle, description: customDescription, path: customPath, ogImage: customOgImage, ogType: customOgType } = Astro.props;

const currentPath = customPath || Astro.url.pathname;
const seo = generateSeo(currentPath);

const defaultDescription = "Flávio Sólon (Flávio Sólon Araújo Dutra) — Engenheiro de Software Full-Stack em Manaus. Especialista em Rust, Laravel, Svelte 5, Angular e Astro.";

const finalTitle = customTitle ? `${customTitle} | Flávio Sólon` : seo.title;
const finalDescription = customDescription || seo.description || defaultDescription;
const finalOgImage = customOgImage || seo.ogImage;
const finalOgType = customOgType || seo.ogType;

// Força sempre o protocolo https:// e o domínio canônico https://flaviosolon.com
const targetPath = (customPath || Astro.url.pathname).replace(/\/$/, '') || '/';
const normalizedPath = targetPath === '/' ? '/' : `${targetPath}/`;
const canonicalURL = new URL(normalizedPath, 'https://flaviosolon.com').toString().replace(/^http:/, 'https:');

// Unified Canonical Knowledge Graph for SEO, AEO & GEO
const canonicalEntityGraph = [
  {
    "@type": "WebSite",
    "@id": "https://flaviosolon.com/#website",
    "url": "https://flaviosolon.com/",
    "name": "Flávio Sólon — Engenheiro de Software Full-Stack em Manaus e no Brasil",
    "inLanguage": "pt-BR",
    "publisher": { "@id": "https://flaviosolon.com/#person" }
  },
  {
