---
import '@/index.css';
import { generateSeo } from '@/lib/seo';

interface Props {
  title?: string;
  description?: string;
  path?: string;
  ogImage?: string;
  ogType?: 'website' | 'article' | 'profile';
}

const { title: customTitle, description: customDescription, path: customPath, ogImage: customOgImage, ogType: customOgType } = Astro.props;

const currentPath = customPath || Astro.url.pathname;
const seo = generateSeo(currentPath);

const defaultDescription = "Flávio Sólon (Flávio Sólon Araújo Dutra) — Engenheiro de Software Full-Stack em Manaus. Especialista em Rust, Laravel, Svelte 5, Angular e Astro.";

const finalTitle = customTitle ? `${customTitle} | Flávio Sólon` : seo.title;
const finalDescription = customDescription || seo.description || defaultDescription;
const finalOgImage = customOgImage || seo.ogImage;
const finalOgType = customOgType || seo.ogType;
const canonicalURL = seo.canonicalUrl;

// Unified Canonical Knowledge Graph for SEO, AEO & GEO
const canonicalEntityGraph = [
  {
    "@type": "WebSite",
    "@id": "https://flaviosolon.com/#website",
    "url": "https://flaviosolon.com/",
    "name": "Flávio Sólon — Engenharia de Software Full-Stack",
    "inLanguage": "pt-BR",
    "publisher": { "@id": "https://flaviosolon.com/#person" }
  },
  {
    "@type": "Person",
    "@id": "https://flaviosolon.com/#person",
    "name": "Flávio Sólon",
    "givenName": "Flávio Sólon",
    "familyName": "Araújo Dutra",
    "alternateName": [
      "Flávio Sólon Araújo Dutra",
      "Flavio Solon",
      "Flavio Solon Araujo Dutra"
    ],
    "url": "https://flaviosolon.com/",
    "image": "https://flaviosolon.com/og-image.jpg",
    "email": "mailto:contato@flaviosolon.com",
    "jobTitle": "Engenheiro de Software Full-Stack Sênior",
    "description": "Engenheiro de Software Full-Stack em Manaus (AM), especialista no desenvolvimento prático de sistemas web, plataformas EAD, telemetria veicular, marketplaces e micro-SaaS com Rust, Laravel, Svelte 5, Angular e Astro.",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Manaus",
      "addressRegion": "AM",
      "addressCountry": "BR"
    },
    "knowsAbout": [
      "Rust",
      "Laravel",
      "PHP",
      "Svelte 5",
      "SvelteKit",
      "Angular",
      "Astro",
      "React",
      "Vue.js",
      "Arquitetura de Software Escalável",
      "Plataformas EAD",
      "Sistemas de Rastreamento Veicular",
      "Marketplaces e E-commerce",
      "Karatê Shinkyokushin",
      "Kickboxing",
      "Violão Erudito"
    ],
    "sameAs": [
      "https://github.com/FlavioSolon",
      "https://www.linkedin.com/in/flaviosolon"
    ]
  },
  {
    "@type": "ProfessionalService",
    "@id": "https://flaviosolon.com/#service",
    "name": "Flávio Sólon — Desenvolvimento de Software sob Medida",
    "url": "https://flaviosolon.com/",
    "image": "https://flaviosolon.com/og-image.jpg",
    "email": "contato@flaviosolon.com",
    "priceRange": "$$$",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Manaus",
      "addressRegion": "AM",
      "addressCountry": "BR"
    },
    "areaServed": [
      { "@type": "City", "name": "Manaus" },
      { "@type": "Country", "name": "Brasil" }
    ],
    "founder": { "@id": "https://flaviosolon.com/#person" }
  },
  {
    "@type": "FAQPage",
    "@id": "https://flaviosolon.com/#faq",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Por que combinar Rust e Laravel?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "O Laravel oferece produtividade extrema e um ecossistema maduro para regras de negócio, autenticação e gestão corporativa, enquanto o Rust assume rotas críticas de alta concorrência, workers financeiros e processamento em tempo real com consumo mínimo de memória."
        }
      },
      {
        "@type": "Question",
        "name": "Quando escolher Svelte 5, Angular ou Astro?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Astro é imbatível para páginas orientadas a conteúdo e SEO máximo com Zero-JS por padrão. Svelte 5 (Runes) entrega reatividade cirúrgica para SaaS e interfaces fluidas. Angular é a escolha ideal para sistemas corporativos complexos que exigem arquitetura padronizada em larga escala."
        }
      },
      {
        "@type": "Question",
        "name": "Você trabalha com empresas de Manaus e de fora do Amazonas?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Sim. Baseado em Manaus (AM), atuo presencialmente ou remotamente para empresas locais do Polo Industrial e negócios da região, além de atender empresas e startups em todo o Brasil e no exterior."
        }
      },
      {
        "@type": "Question",
        "name": "Como contratar o Flávio Sólon para resolver problemas em um sistema existente ou criar um produto do zero?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Atuo diretamente no código (hands-on) tanto na refatoração de sistemas legados, correção de gargalos de performance e bancos de dados, quanto no desenvolvimento ponta a ponta de novos produtos SaaS, plataformas EAD, telemetria e marketplaces."
        }
      }
    ]
  }
];

const contextGraph = Array.isArray(seo.jsonLd?.['@graph'])
  ? (seo.jsonLd['@graph'] as Record<string, unknown>[]).filter(
      (item) => item['@type'] !== 'Person' && item['@type'] !== 'ProfessionalService' && item['@type'] !== 'WebSite' && item['@type'] !== 'FAQPage'
    )
  : [];

const schemaGraph = {
  "@context": "https://schema.org",
  "@graph": [
    ...canonicalEntityGraph,
    ...contextGraph
  ]
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{finalTitle}</title>
    <meta name="description" content={finalDescription} />
    <meta name="author" content="Flávio Sólon" />
    <meta name="theme-color" content="#0B0D0E" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="pt-BR" href={canonicalURL} />
    <link rel="alternate" hreflang="x-default" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- GEO & Local Relevance (Manaus, Amazonas, Brasil) -->
    <meta name="geo.region" content={seo.geo.region} />
    <meta name="geo.placename" content={seo.geo.placename} />
    <meta name="geo.position" content={seo.geo.position} />
    <meta name="ICBM" content={seo.geo.icbm} />

    <!-- Open Graph (WhatsApp, LinkedIn, Social Networks) -->
    <meta property="og:site_name" content="Flávio Sólon — Da missão ao código" />
    <meta property="og:type" content={finalOgType} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:url" content={seo.canonicalUrl} />
    <meta property="og:title" content={finalTitle} />
    <meta property="og:description" content={finalDescription} />
    <meta property="og:image" content={finalOgImage} />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@flaviosolon_" />
    <meta name="twitter:creator" content="@flaviosolon_" />
    <meta name="twitter:title" content={finalTitle} />
    <meta name="twitter:description" content={finalDescription} />
    <meta name="twitter:image" content={finalOgImage} />

    <!-- Performance & Typography Preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;450;500;550;600;650;700&family=Syne:wght@400;500;600;650;700;750;800&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;450;500;550;600;650;700&family=Syne:wght@400;500;600;650;700;750;800&family=JetBrains+Mono:wght@400;500&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;450;500;550;600;650;700&family=Syne:wght@400;500;600;650;700;750;800&family=JetBrains+Mono:wght@400;500&display=swap"
      />
    </noscript>

    <!-- JSON-LD Structured Data Graph for SEO, AEO & GEO -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaGraph).replaceAll('<', '\\u003c')} />
  </head>
  <body>
    <slot />
  </body>
</html>
