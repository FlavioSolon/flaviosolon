---
import Layout from '@/layouts/Layout.astro';
import MobileNav from '@/components/svelte/MobileNav.svelte';
import ProjectFilter from '@/components/svelte/ProjectFilter.svelte';
import PillarTabs from '@/components/svelte/PillarTabs.svelte';
import { Picture } from 'astro:assets';
import heroImage from '@/assets/flaviosolon.jpeg';
import { getProfile, getProjects, getFaqs, getArticles } from '@/lib/db';

const profile = getProfile();
const projects = getProjects();
const faqs = getFaqs();
const articles = getArticles();
---

<Layout
  path="/"
  title="Flávio Sólon | Engenheiro de Software Full-Stack em Manaus — Sistemas Sob Medida, SaaS e Web"
  description="Flávio Sólon (Flávio Sólon Araújo Dutra) — Engenheiro de Software Full-Stack em Manaus e Brasil. Criação e modernização de sistemas em Laravel, Rust, Svelte e Angular."
>
  <div class="site-shell">
    <a class="skip-link" href="#main">Pular para o conteúdo</a>

    <MobileNav client:idle whatsappUrl={profile.whatsapp} currentPath="/" />

    <main id="main">
      <!-- HERO SECTION -->
      <section class="hero">
        <div class="hero-content">
          <div class="availability">
            <i></i> DISPONÍVEL PARA NOVOS PROJETOS <span>2026</span>
          </div>
          <h1>
            Da missão<br />
            <span>ao código.</span>
          </h1>
          <div class="hero-manifesto">
            Desenvolvo sistemas que ajudam empresas a automatizar tarefas, organizar operações e crescer.
          </div>
          <div class="hero-intro about-semantic-block" id="sobre">
            <p class="hero-canonical">
              Olá, sou <strong>Flávio Sólon (Flávio Sólon Araújo Dutra)</strong>, <strong>engenheiro de software full-stack em Manaus</strong>. Construo plataformas digitais do zero e modernizo sistemas existentes para reduzir lentidão, aumentar a segurança e melhorar a experiência de quem usa — unindo engenharia de software de alta precisão e visão prática de negócios.
            </p>
            <div class="hero-actions">
              <a class="button button-copper" href="#contato">
                Diagnosticar meu projeto <span aria-hidden="true">↗</span>
              </a>
              <a class="text-link" href="#projetos">
                Explorar projetos <span>↓</span>
              </a>
            </div>
            <div class="hero-trust-badge">
              Atuação 100% hands-on (mão no código) · Atendimento em Manaus, Brasil e Exterior
            </div>
            <div class="hero-details">
              <p>
                No dia a dia técnico, atuo diretamente no código com <strong>Laravel (PHP), Rust, Svelte 5, Angular, Astro, React e Vue</strong>, criando desde <strong>sistemas internos de gestão, plataformas educacionais (EAD) e portais corporativos</strong> até <strong>e-commerces, marketplaces e aplicativos web (SaaS)</strong>.
              </p>
              <p>
                Paralelamente, atuo como missionário em comunidades ribeirinhas na <strong>Amazônia</strong> e em periferias. A escassez de recursos me ensinou a criar soluções que funcionam no mundo real, sem complicação. Também pratico <strong>Karatê Shinkyokushin</strong>, <strong>Kickboxing</strong> e estudo <strong>violão clássico/erudito</strong> — disciplinas que refletem meu foco, constância e atenção aos detalhes.
              </p>
            </div>
          </div>
          <div class="hero-location">
            <span class="location-icon">⌖</span> {profile.location.city.toUpperCase()}, {profile.location.country.toUpperCase()}
            <span class="location-line"></span> ATUAÇÃO GLOBAL
          </div>
        </div>

        <div class="hero-art">
          <Picture
            src={heroImage}
            alt="Flávio Sólon, engenheiro de software full-stack em Manaus, sorrindo em retrato em preto e branco"
            widths={[420, 640, 900]}
            sizes="(max-width: 760px) 90vw, (max-width: 1500px) 44vw, 640px"
            formats={['avif', 'webp']}
            quality={72}
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="hero-art-img"
          />
          <div class="art-shade"></div>
          <div class="art-coordinate">
            03°06′ S &nbsp; 60°01′ W <span>AMAZÔNIA / BRASIL</span>
          </div>
          <div class="art-note">
            <span>01 / ORIGEM & DIREÇÃO</span>
            <p>
              Raízes profundas.<br />
              Horizontes sem limites.
            </p>
          </div>
          <div class="art-corner">
            FS —<br />
            EST. MANAUS
          </div>
        </div>
      </section>

      <!-- STACK STRIP -->
      <div class="stack-strip">
        <span class="mono stack-intro">FERRAMENTAS, NÃO LIMITES</span>
        {['Rust', 'Laravel', 'Svelte 5', 'Angular', 'Astro'].map((s, i) => (
          <span class="stack-name">
            <span class="stack-icon">{['⚙', '◇', '≋', '△', 'Λ'][i]}</span>
            {s}
          </span>
        ))}
        <span class="stack-end">PRECISÃO EM CADA CAMADA ↗</span>
      </div>

      <!-- PROJECTS SECTION (SVELTE 5 REACTIVE ISLAND) -->
      <section class="projects section" id="projetos">
        <div class="section-heading">
          <div>
            <div class="eyebrow">
              <span>01</span> / ENGENHARIA EM PRÁTICA
            </div>
            <h2>
              Ideias em produção<span>.</span>
            </h2>
          </div>
          <p>
            Problemas reais. Decisões conscientes.<br />
            Software que entrega além da tela.
          </p>
        </div>

        <ProjectFilter client:visible projects={projects} email={profile.email} />
      </section>

      <!-- ESSENCE SECTION (SVELTE 5 REACTIVE PILLARS) -->
      <section class="essence section" id="essencia">
        <div class="section-heading">
          <div>
            <div class="eyebrow">
              <span>02</span> / RAIZ, MENTE & CÓDIGO
            </div>
            <h2>
              O código é só uma parte<span>.</span>
            </h2>
          </div>
          <p>
            A excelência se constrói fora da tela.<br />
            E se revela em cada linha.
          </p>
        </div>

        <PillarTabs client:visible />
      </section>

      <!-- PROBLEMS I SOLVE SECTION (COMO AJUDO SUA EMPRESA - DUAL-LAYER) -->
      <section class="solutions section" id="solucoes">
        <div class="section-heading">
          <div>
            <div class="eyebrow">
              <span>03</span> / COMO AJUDO SUA EMPRESA
            </div>
            <h2>
              Soluções claras para<br />
              <span>problemas reais.</span>
            </h2>
          </div>
          <p>
            Para quem precisa de resultado prático no negócio e excelência de ponta a ponta no código.
          </p>
        </div>

        <div class="solutions-grid">
          <div class="solution-card">
            <span class="solution-num">01</span>
            <h3>Fim da Lentidão e Travamentos</h3>
            <p>Seu sistema demora para carregar, cai nos horários de pico ou trava a rotina da equipe? Identifico a causa exata do problema e otimizo a plataforma para que tudo funcione de forma rápida, estável e econômica.</p>
            <div class="solution-tech-spec">
              <strong>Na engenharia:</strong>
              Otimização de queries em bancos sobrecarregados (PostgreSQL/MySQL), correção de gargalos em APIs Laravel/PHP e criação de microsserviços de alta concorrência em Rust.
            </div>
            <div class="solution-tag">RUST · LARAVEL · BANCO DE DADOS</div>
            <a class="solution-cta" href="https://wa.me/5592984167784?text=Ol%C3%A1%20Fl%C3%A1vio%2C%20preciso%20resolver%20lentid%C3%A3o%20ou%20gargalos%20em%20um%20sistema." target="_blank" rel="noopener noreferrer">
              Resolver lentidão ↗
            </a>
          </div>

          <div class="solution-card">
            <span class="solution-num">02</span>
            <h3>Sistemas Sob Medida e Automação</h3>
            <p>Sua empresa ainda depende de planilhas manuais ou processos espalhados? Desenvolvo sistemas próprios e plataformas digitais fáceis de usar no computador ou celular para organizar sua operação, automatizar cobranças e escalar suas vendas.</p>
            <div class="solution-tech-spec">
              <strong>Na engenharia:</strong>
              Arquitetura full-stack de plataformas SaaS, portais EAD, marketplaces com divisão automática de pagamentos (Split Pix) e interfaces reativas de alta conversão.
            </div>
            <div class="solution-tag">SVELTE 5 · ASTRO · SAAS & PIX</div>
            <a class="solution-cta" href="https://wa.me/5592984167784?text=Ol%C3%A1%20Fl%C3%A1vio%2C%20quero%20desenvolver%20um%20sistema%20sob%20medida%20para%20minha%20empresa." target="_blank" rel="noopener noreferrer">
              Criar sistema sob medida ↗
            </a>
          </div>

          <div class="solution-card">
            <span class="solution-num">03</span>
            <h3>Modernização de Sistemas em Laravel e PHP</h3>
            <p>Atualizo e reorganizo sistemas que sua empresa já utiliza para melhorar a segurança, corrigir falhas antigas e tornar o uso das telas mais simples. As mudanças são planejadas para preservar as funcionalidades da empresa e reduzir interrupções na rotina da equipe.</p>
            <div class="solution-tech-spec">
              <strong>Na engenharia:</strong>
              Refatoração segura de sistemas legados (zero downtime), atualização de versões de PHP/Laravel, separação de funcionalidades (monolitos) e renovação das telas com Angular ou Svelte.
            </div>
            <div class="solution-tag">LARAVEL · ANGULAR · REFATORAÇÃO SEGURA</div>
            <a class="solution-cta" href="https://wa.me/5592984167784?text=Ol%C3%A1%20Fl%C3%A1vio%2C%20preciso%20modernizar%20e%20atualizar%20um%20sistema%20existente." target="_blank" rel="noopener noreferrer">
              Modernizar meu sistema ↗
            </a>
          </div>
        </div>
      </section>

      <!-- APPROACH & FAQS -->
      <section class="approach section" id="abordagem">
        <div>
          <div class="eyebrow">
            <span>04</span> / ARQUITETURA & DECISÕES
          </div>
          <h2>
            Intenção antes<br />
            da implementação<span>.</span>
          </h2>
          <p class="approach-description">
            A melhor tecnologia é aquela que resolve o problema certo. Sem
            excessos. Sem atalhos que custam caro depois.
          </p>
        </div>
        <div class="faq-list">
          {faqs.map((f, i) => (
            <details>
              <summary>
                <span class="mono">0{i + 1}</span>
                {f.question}
                <span class="faq-plus">+</span>
              </summary>
              <p>{f.answer}</p>
            </details>
          ))}
        </div>
      </section>

      <!-- HOME JOURNAL TEASER -->
      <section class="home-journal section" aria-labelledby="journal-title">
        <div class="eyebrow">
          <span>05</span> / IDEIAS QUE MERECEM CIRCULAR
        </div>
        <div class="section-heading">
          <div>
            <h2 id="journal-title">
              Da prática à reflexão<span>.</span>
            </h2>
            <p class="journal-description">
              Arquitetura, tecnologia e desenvolvimento com propósito. Artigos
              para compartilhar decisões, não apenas ferramentas.
            </p>
          </div>
          <a class="button button-outline" href="/blog/">
            Explorar artigos <span aria-hidden="true">↗</span>
          </a>
        </div>

        <div class="home-articles-grid">
          {articles.map((a) => (
            <article class="home-article-card">
              <div class="home-article-meta">
                <span class="home-article-cat">{a.category}</span>
                <span class="home-article-read">{a.readingTime} de leitura</span>
              </div>
              <h3>
                <a href={`/blog/${a.slug}/`}>{a.title}</a>
              </h3>
              <p>{a.description}</p>
              <a class="home-article-link" href={`/blog/${a.slug}/`}>
                Ler artigo completo <span aria-hidden="true">↗</span>
              </a>
            </article>
          ))}
        </div>
      </section>

      <!-- CONTACT SECTION -->
      <section class="contact section" id="contato">
        <div class="eyebrow">
          <i></i> ABERTO A BOAS CONVERSAS
        </div>
        <h2>
          Seu próximo desafio.<br />
          <span>Nossa próxima construção.</span>
        </h2>
        <div class="contact-bottom">
          <p>
            Uma ideia, um sistema para evoluir ou um problema complexo.<br />
            Vamos encontrar o caminho mais sólido.
          </p>
          <a
            class="button button-copper"
            href={profile.whatsapp}
            target="_blank"
            rel="noopener noreferrer"
          >
            Conversar no WhatsApp <span aria-hidden="true">↗</span>
          </a>
        </div>
        <a class="contact-email" href={`mailto:${profile.email}`}>
          {profile.email} <span aria-hidden="true">↗</span>
        </a>
        <div class="social-links" aria-label="Redes sociais">
          {profile.socials.map((s) => (
            <a href={s.url} target="_blank" rel="noopener noreferrer">
              {s.name} ↗
            </a>
          ))}
        </div>
      </section>
    </main>

    <footer>
      <a class="footer-logo" href="/">
        flávio sólon<span>.</span>
      </a>
      <span class="mono">FEITO COM INTENÇÃO. DIRETO DA AMAZÔNIA.</span>
      <div>
        {profile.socials.map((s) => (
          <a href={s.url} target="_blank" rel="noopener noreferrer">
            {s.name} ↗
          </a>
        ))}
        <span>© {new Date().getFullYear()}</span>
      </div>
    </footer>
  </div>
</Layout>
