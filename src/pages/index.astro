---
import Layout from '@/layouts/Layout.astro';
import MobileNav from '@/components/svelte/MobileNav.svelte';
import ProjectFilter from '@/components/svelte/ProjectFilter.svelte';
import PillarTabs from '@/components/svelte/PillarTabs.svelte';
import { Picture } from 'astro:assets';
import heroImage from '@/assets/hero-amazonia.jpg';
import { getProfile, getProjects, getFaqs, getArticles } from '@/lib/db';

const profile = getProfile();
const projects = getProjects();
const faqs = getFaqs();
const articles = getArticles();
---

<Layout
  path="/"
  description="Flávio Sólon (Flávio Sólon Araújo Dutra) — Desenvolvedor Full-Stack Sênior em Manaus e Brasil. Criação de sistemas sob medida, SaaS, aplicativos web em Laravel, Rust, Svelte e Angular."
>
  <div class="site-shell">
    <a class="skip-link" href="#main">Pular para o conteúdo</a>

    <MobileNav client:idle whatsappUrl={profile.whatsapp} currentPath="/" />

    <main id="main">
      <!-- HERO SECTION -->
      <section class="hero">
        <div class="hero-content">
          <div class="availability">
            <i></i> DISPONÍVEL PARA NOVOS PROJETOS <span>2026</span>
          </div>
          <h1>
            Da missão<br />
            <span>ao código.</span>
          </h1>
          <div class="hero-manifesto">
            Engenharia de software de alta precisão para sistemas críticos, SaaS e negócios que precisam escalar.
          </div>
          <div class="hero-intro about-semantic-block" id="sobre">
            <p class="hero-canonical">
              Olá, sou <strong>Flávio Sólon (Flávio Sólon Araújo Dutra)</strong>, <strong>desenvolvedor full-stack em Manaus</strong> focado na construção de sistemas críticos e resolução de problemas reais. Minha jornada caminha em duas vias que se complementam: a tecnologia de alta precisão e o serviço humanitário na <strong>Amazônia</strong>.
            </p>
            <div class="hero-actions">
              <a class="button button-copper" href="#contato">
                Diagnosticar meu projeto <span aria-hidden="true">↗</span>
              </a>
              <a class="text-link" href="#projetos">
                Explorar projetos <span>↓</span>
              </a>
            </div>
            <div class="hero-trust-badge">
              Atuação 100% hands-on (mão no código) · Atendimento em Manaus, Brasil e Exterior
            </div>
            <div class="hero-details">
              <p>
                Experiência sólida em <strong>Laravel, Svelte, Vue, React, Angular e Rust</strong>, projetando arquiteturas escaláveis para <strong>plataformas EAD, sistemas educacionais, rastreamento veicular, e-commerces e marketplaces</strong>.
              </p>
              <p>
                Atuo como missionário junto a comunidades ribeirinhas na Amazônia e em periferias. A escassez de recursos me ensinou resiliência, adaptabilidade e a construir soluções que realmente importam — no código e na vida. Pratico <strong>Karatê Shinkyokushin</strong>, <strong>Kickboxing</strong> e violão erudito — disciplinas que sustentam meu rigor técnico e precisão.
              </p>
            </div>
          </div>
          <div class="hero-location">
            <span class="location-icon">⌖</span> {profile.location.city.toUpperCase()}, {profile.location.country.toUpperCase()}
            <span class="location-line"></span> ATUAÇÃO GLOBAL
          </div>
        </div>

        <div class="hero-art">
          <Picture
            src={heroImage}
            alt="Vista aérea da floresta amazônica e de seu rio — base e inspiração de Flávio Sólon em Manaus"
            widths={[360, 540, 720]}
            sizes="(max-width: 700px) 92vw, (max-width: 1200px) 45vw, 600px"
            formats={['avif', 'webp']}
            quality={50}
            loading="eager"
            fetchpriority="high"
            decoding="async"
            width={600}
            height={400}
            class="hero-art-img aspect-[3/2] w-full h-auto object-cover"
          />
          <div class="art-shade"></div>
          <div class="art-coordinate">
            03°06′ S &nbsp; 60°01′ W <span>AMAZÔNIA / BRASIL</span>
          </div>
          <svg class="orbit-art" viewBox="0 0 500 500" fill="none" aria-hidden="true">
            <g transform="translate(250 245)">
              <circle r="169"></circle>
              <circle r="122"></circle>
              <ellipse rx="169" ry="65" transform="rotate(-38)"></ellipse>
              <ellipse rx="169" ry="65" transform="rotate(38)"></ellipse>
              <ellipse rx="65" ry="169"></ellipse>
              <path d="M-201 0H201M0-205V205" class="orbit-axis"></path>
              <circle r="8" class="orbit-center"></circle>
              <circle cx="133" cy="-105" r="5" class="orbit-point"></circle>
            </g>
          </svg>
          <div class="art-note">
            <span>01 / ORIGEM & DIREÇÃO</span>
            <p>
              Raízes profundas.<br />
              Horizontes sem limites.
            </p>
          </div>
          <div class="art-corner">
            FS —<br />
            EST. MANAUS
          </div>
          <a
            class="photo-credit"
            href="https://unsplash.com/@kiyoshi_jpg"
            target="_blank"
            rel="noreferrer"
          >
            Fotografia: Andres Medina
          </a>
        </div>
      </section>

      <!-- STACK STRIP -->
      <div class="stack-strip">
        <span class="mono stack-intro">FERRAMENTAS, NÃO LIMITES</span>
        {['Rust', 'Laravel', 'Svelte 5', 'Angular', 'Astro'].map((s, i) => (
          <span class="stack-name">
            <span class="stack-icon">{['⚙', '◇', '≋', '△', 'Λ'][i]}</span>
            {s}
          </span>
        ))}
        <span class="stack-end">PRECISÃO EM CADA CAMADA ↗</span>
      </div>

      <!-- PROJECTS SECTION (SVELTE 5 REACTIVE ISLAND) -->
      <section class="projects section" id="projetos">
        <div class="section-heading">
          <div>
            <div class="eyebrow">
              <span>01</span> / ENGENHARIA EM PRÁTICA
            </div>
            <h2>
              Ideias em produção<span>.</span>
            </h2>
          </div>
          <p>
            Problemas reais. Decisões conscientes.<br />
            Software que entrega além da tela.
          </p>
        </div>

        <ProjectFilter client:visible projects={projects} email={profile.email} />
      </section>

      <!-- ESSENCE SECTION (SVELTE 5 REACTIVE PILLARS) -->
      <section class="essence section" id="essencia">
        <div class="section-heading">
          <div>
            <div class="eyebrow">
              <span>02</span> / RAIZ, MENTE & CÓDIGO
            </div>
            <h2>
              O código é só uma parte<span>.</span>
            </h2>
          </div>
          <p>
            A excelência se constrói fora da tela.<br />
            E se revela em cada linha.
          </p>
        </div>

        <PillarTabs client:visible />
      </section>

      <!-- PROBLEMS I SOLVE SECTION (CRO & CONVERSION FOCUS) -->
      <section class="solutions section" id="solucoes">
        <div class="section-heading">
          <div>
            <div class="eyebrow">
              <span>03</span> / VALOR DE NEGÓCIO & IMPACTO
            </div>
            <h2>
              Problemas de negócio<br />
              <span>que eu resolvo.</span>
            </h2>
          </div>
          <p>
            Engenharia hands-on orientada a estabilidade, escalabilidade e resultado financeiro real.
          </p>
        </div>

        <div class="solutions-grid">
          <div class="solution-card">
            <span class="solution-num">01</span>
            <h3>Sistemas Lentos & Gargalos Críticos</h3>
            <p>Diagnóstico cirúrgico e eliminação de lentidão em APIs, otimização de queries em bancos sobrecarregados e extração de microsserviços de alta concorrência em Rust para desonerar o backend com consumo mínimo de memória.</p>
            <div class="solution-tag">RUST · POSTGRESQL · ALTA ESCALA</div>
            <a class="solution-cta" href="https://wa.me/5592984167784?text=Ol%C3%A1%20Fl%C3%A1vio%2C%20preciso%20resolver%20gargalos%20de%20performance%20em%20um%20sistema." target="_blank" rel="noopener noreferrer">
              Resolver gargalo técnico <span aria-hidden="true">↗</span>
            </a>
          </div>

          <div class="solution-card">
            <span class="solution-num">02</span>
            <h3>Criação de SaaS, EAD & Marketplaces</h3>
            <p>Construção de produtos digitais robustos do zero à produção: arquitetura escalável multi-tenant, gateways de pagamento, controle de concorrência e telemetria veicular em tempo real com tolerância a falhas.</p>
            <div class="solution-tag">SVELTE 5 · ASTRO · TELEMETRIA</div>
            <a class="solution-cta" href="https://wa.me/5592984167784?text=Ol%C3%A1%20Fl%C3%A1vio%2C%20quero%20desenvolver%20um%20SaaS%20ou%20plataforma%20sob%20medida." target="_blank" rel="noopener noreferrer">
              Tirar projeto do papel <span aria-hidden="true">↗</span>
            </a>
          </div>

          <div class="solution-card">
            <span class="solution-num">03</span>
            <h3>Modernização de Legados em Laravel/PHP</h3>
            <p>Refatoração segura de sistemas legados sem paralisar a operação. Upgrade de versões, blindagem de segurança, desacoplamento de monolitos e reformulação de interfaces corporativas em Angular e Svelte.</p>
            <div class="solution-tag">LARAVEL · ANGULAR · ZERO DOWNTIME</div>
            <a class="solution-cta" href="https://wa.me/5592984167784?text=Ol%C3%A1%20Fl%C3%A1vio%2C%20preciso%20modernizar%20um%20sistema%20legado." target="_blank" rel="noopener noreferrer">
              Modernizar meu sistema <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </section>

      <!-- APPROACH & FAQS -->
      <section class="approach section" id="abordagem">
        <div>
          <div class="eyebrow">
            <span>04</span> / ARQUITETURA & DECISÕES
          </div>
          <h2>
            Intenção antes<br />
            da implementação<span>.</span>
          </h2>
          <p class="approach-description">
            A melhor tecnologia é aquela que resolve o problema certo. Sem
            excessos. Sem atalhos que custam caro depois.
          </p>
        </div>
        <div class="faq-list">
          {faqs.map((f, i) => (
            <details>
              <summary>
                <span class="mono">0{i + 1}</span>
                {f.question}
                <span class="faq-plus">+</span>
              </summary>
              <p>{f.answer}</p>
            </details>
          ))}
        </div>
      </section>

      <!-- HOME JOURNAL TEASER -->
      <section class="home-journal section" aria-labelledby="journal-title">
        <div class="eyebrow">
          <span>05</span> / IDEIAS QUE MERECEM CIRCULAR
        </div>
        <div class="section-heading">
          <div>
            <h2 id="journal-title">
              Da prática à reflexão<span>.</span>
            </h2>
            <p class="journal-description">
              Arquitetura, tecnologia e desenvolvimento com propósito. Artigos
              para compartilhar decisões, não apenas ferramentas.
            </p>
          </div>
          <a class="button button-outline" href="/blog/">
            Explorar artigos <span aria-hidden="true">↗</span>
          </a>
        </div>

        <div class="home-articles-grid">
          {articles.map((a) => (
            <article class="home-article-card">
              <div class="home-article-meta">
                <span class="home-article-cat">{a.category}</span>
                <span class="home-article-read">{a.readingTime} de leitura</span>
              </div>
              <h3>
                <a href={`/blog/${a.slug}/`}>{a.title}</a>
              </h3>
              <p>{a.description}</p>
              <a class="home-article-link" href={`/blog/${a.slug}/`}>
                Ler artigo completo <span aria-hidden="true">↗</span>
              </a>
            </article>
          ))}
        </div>
      </section>

      <!-- CONTACT SECTION -->
      <section class="contact section" id="contato">
        <div class="eyebrow">
          <i></i> ABERTO A BOAS CONVERSAS
        </div>
        <h2>
          Seu próximo desafio.<br />
          <span>Nossa próxima construção.</span>
        </h2>
        <div class="contact-bottom">
          <p>
            Uma ideia, um sistema para evoluir ou um problema complexo.<br />
            Vamos encontrar o caminho mais sólido.
          </p>
          <a
            class="button button-copper"
            href={profile.whatsapp}
            target="_blank"
            rel="noopener noreferrer"
          >
            Conversar no WhatsApp <span aria-hidden="true">↗</span>
          </a>
        </div>
        <a class="contact-email" href={`mailto:${profile.email}`}>
          {profile.email} <span aria-hidden="true">↗</span>
        </a>
        <div class="social-links" aria-label="Redes sociais">
          {profile.socials.map((s) => (
            <a href={s.url} target="_blank" rel="noopener noreferrer">
              {s.name} ↗
            </a>
          ))}
        </div>
      </section>
    </main>

    <footer>
      <a class="footer-logo" href="/">
        flávio sólon<span>.</span>
      </a>
      <span class="mono">FEITO COM INTENÇÃO. DIRETO DA AMAZÔNIA.</span>
      <div>
        {profile.socials.map((s) => (
          <a href={s.url} target="_blank" rel="noopener noreferrer">
            {s.name} ↗
          </a>
        ))}
        <span>© {new Date().getFullYear()}</span>
      </div>
    </footer>
  </div>
</Layout>
