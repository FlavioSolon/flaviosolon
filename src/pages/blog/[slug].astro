---
import Layout from '@/layouts/Layout.astro';
import { getProfile, getArticleBySlug, getArticles, type Article } from '@/lib/db';

export async function getStaticPaths() {
  const articles = getArticles(false);
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

type Props = {
  article: Article;
};

const { slug } = Astro.params;
const profile = getProfile();
const props = Astro.props as Props;
const article = props.article || getArticleBySlug(slug as string);

if (!article) {
  return Astro.redirect('/blog/');
}

const allArticles = getArticles(false);
const relatedArticles = allArticles
  .filter((a) => a.slug !== article.slug)
  .slice(0, 3);

const isoPublishedTime = article.date.includes('T')
  ? article.date
  : `${article.date}T10:00:00-04:00`;

function formatDate(value: string) {
  try {
    return new Date(`${value}T12:00:00Z`).toLocaleDateString('pt-BR', {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
      timeZone: 'UTC',
    });
  } catch {
    return value;
  }
}
---

<Layout
  path={`/blog/${article.slug}/`}
  title={article.title}
  description={article.description}
  isArticle={true}
  publishedTime={isoPublishedTime}
  modifiedTime={isoPublishedTime}
  section={article.category}
  image={article.coverImage || "/og-image.jpg"}
  tags={article.tags}
  articleHeadline={article.title}
>
  <div class="site-shell blog-shell">
    <a class="skip-link" href="#main">Pular para o conteúdo</a>

    <header class="header">
      <a class="wordmark" href="/">
        flávio sólon<span class="logo-dot">.</span>
        <span class="wordmark-sub">SOFTWARE ENGINEER</span>
      </a>
      <nav class="blog-nav" aria-label="Navegação principal">
        <a href="/">Portfólio</a>
        <a href="/blog/">Artigos</a>
      </nav>
      <a
        class="header-contact"
        href={profile.whatsapp}
        target="_blank"
        rel="noopener noreferrer"
      >
        WhatsApp ↗
      </a>
    </header>

    <main id="main">
      <article class="reading-page">
        <nav class="breadcrumbs" aria-label="Caminho da página">
          <a href="/">Início</a>
          <span>/</span>
          <a href="/blog/">Blog</a>
          <span>/</span>
          <span>{article.category}</span>
        </nav>

        <header class="reading-header">
          <div class="eyebrow">{article.category}</div>
          <h1>{article.title}</h1>
          <p class="article-lead">{article.description}</p>
          <div class="article-meta">
            <span class="article-byline">Por <a href="/#sobre">{profile.name}</a></span>
            <span class="meta-dot">·</span>
            <time datetime={isoPublishedTime}>{formatDate(article.date)}</time>
            <span class="meta-dot">·</span>
            <span class="article-reading-time">{article.readingTime} de leitura</span>
          </div>

          <!-- GEO Geographic Reference Badge -->
          {article.geoContext && (
            <div class="geo-tag">
              <span class="geo-dot"></span>
              <span>{article.geoContext} (Manaus, Amazonas, Brasil)</span>
            </div>
          )}

          <!-- AEO (Answer Engine Optimization) Direct Answer Box -->
          {article.aeoSummary && (
            <aside class="aeo-box" aria-label="Síntese Executiva para Resposta Rápida e IAs">
              <div class="aeo-box-header">
                <span class="aeo-label">
                  ⚡ SÍNTESE EXECUTIVA & RESPOSTA DIRETA
                </span>
                <span class="aeo-badge">AEO / IA READY</span>
              </div>
              <p class="aeo-summary aeo-direct-answer">
                {article.aeoSummary}
              </p>
            </aside>
          )}

          {article.coverImage && (
            <figure class="article-cover-wrapper">
              <picture>
                {article.coverImageAvif && <source srcset={article.coverImageAvif} type="image/avif" />}
                {article.coverImageWebp && <source srcset={article.coverImageWebp} type="image/webp" />}
                <img
                  src={article.coverImage}
                  alt={`Infográfico comparativo: ${article.title}`}
                  class="article-cover-img"
                  width="1200"
                  height="630"
                  loading="eager"
                  decoding="async"
                />
              </picture>
              <figcaption class="article-cover-caption">
                <span class="caption-label">FIGURA 1 · ESPECIFICAÇÃO TÉCNICA:</span> Matriz visual de concessões entre Astro + Svelte 5 (Conversão na Borda) e Angular Modern (Governança Enterprise).
              </figcaption>
            </figure>
          )}
        </header>

        <div class="reading-layout">
          <aside class="article-toc">
            <span class="eyebrow">NESTE ARTIGO</span>
            <nav aria-label="Índice do artigo">
              {article.sections.map((s, i) => (
                <a href={`#secao-${i}`}>{s.title}</a>
              ))}
            </nav>
          </aside>

          <div class="article-prose">
            {article.sections.map((s, i) => (
              <section id={`secao-${i}`}>
                <h2>{s.title}</h2>
                {s.paragraphs.map((p) => {
                  if (
                    p.startsWith('<div') ||
                    p.startsWith('<table') ||
                    p.startsWith('<pre') ||
                    p.startsWith('<ul') ||
                    p.startsWith('<ol')
                  ) {
                    return <Fragment set:html={p} />;
                  }
                  return <p set:html={p} />;
                })}
              </section>
            ))}

            <!-- Bloco de Autor Verificado (Author Box) -->
            <section class="verified-author-box" aria-label="Sobre o Autor">
              <div class="author-box-top">
                <img
                  src="/flaviosolon.jpeg"
                  alt="Flávio Sólon — Engenheiro de Software Full-Stack"
                  class="author-avatar"
                  width="68"
                  height="68"
                  loading="lazy"
                />
                <div class="author-info">
                  <span class="author-kicker">AUTOR VERIFICADO · ENGENHARIA DE SOFTWARE</span>
                  <strong class="author-name">{profile.name}</strong>
                  <span class="author-role">Engenheiro de Software Full-Stack &amp; Arquiteto de Soluções</span>
                </div>
              </div>
              <p class="author-bio">
                <strong>Flávio Sólon (Flávio Sólon Araújo Dutra)</strong> é Engenheiro de Software Full-Stack e Arquiteto de Soluções em Manaus (AM). Desenvolve sistemas sob medida, plataformas SaaS e arquiteturas escaláveis com Rust, Laravel (PHP), Svelte 5, Angular e Astro.
              </p>
              <div class="author-links">
                <a href="/" class="author-link">Conhecer Trajetória &amp; Portfólio ↗</a>
                <a href="https://www.linkedin.com/in/flaviosolon" target="_blank" rel="noopener noreferrer" class="author-link">LinkedIn ↗</a>
                <a href="https://github.com/FlavioSolon" target="_blank" rel="noopener noreferrer" class="author-link">GitHub ↗</a>
                <a href={profile.whatsapp} target="_blank" rel="noopener noreferrer" class="author-cta-btn">Falar sobre Projetos ↗</a>
              </div>
            </section>

            {article.cta && (
              <aside class="author-note article-cta" aria-label="Iniciar um projeto">
                <strong>{article.cta.heading}</strong>
                <p>{article.cta.text}</p>
                <div class="hero-actions">
                  <a
                    class="button button-copper"
                    href={profile.whatsapp}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Falar no WhatsApp <span aria-hidden="true">↗</span>
                  </a>
                  <a class="text-link" href="/#projetos">
                    Ver portfólio e casos <span aria-hidden="true">→</span>
                  </a>
                </div>
              </aside>
            )}

            {relatedArticles.length > 0 && (
              <section class="related-articles-section" aria-label="Artigos Relacionados">
                <div class="related-heading">
                  <span class="eyebrow">CONTINUE LENDO</span>
                  <h3>Artigos Relacionados &amp; Decisões Arquiteturais</h3>
                </div>
                <div class="related-articles-grid">
                  {relatedArticles.map((rel) => (
                    <article class="related-article-card">
                      <div class="related-meta">
                        <span class="related-category">{rel.category}</span>
                        <span class="related-reading-time">{rel.readingTime} de leitura</span>
                      </div>
                      <h4>
                        <a href={`/blog/${rel.slug}/`}>{rel.title}</a>
                      </h4>
                      <p>{rel.description}</p>
                      <a class="related-read-link" href={`/blog/${rel.slug}/`}>
                        Ler artigo completo <span aria-hidden="true">→</span>
                      </a>
                    </article>
                  ))}
                </div>
              </section>
            )}

            <div style="margin-top: 35px;">
              <a class="article-read" href="/blog/">
                ← Todos os artigos
              </a>
            </div>
          </div>
        </div>
      </article>

      <section class="journal-contact">
        <h2>
          Uma boa conversa também constrói<span>.</span>
        </h2>
        <a
          class="button button-copper"
          href={profile.whatsapp}
          target="_blank"
          rel="noopener noreferrer"
        >
          Conversar no WhatsApp ↗
        </a>
      </section>
    </main>

    <footer>
      <a class="footer-logo" href="/">
        flávio sólon<span>.</span>
      </a>
      <a href={`mailto:${profile.email}`}>{profile.email}</a>
      <div>
        {profile.socials.map((s) => (
          <a href={s.url} target="_blank" rel="noopener noreferrer">
            {s.name} ↗
          </a>
        ))}
      </div>
    </footer>
  </div>
</Layout>
